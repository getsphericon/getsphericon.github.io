---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  bare?: boolean
}

const { title, description = 'Open-source marketing automation platform.', noindex = false, bare = false } = Astro.props
const fullTitle = title === 'Sphericon' ? title : `${title} · Sphericon`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{fullTitle}</title>
    <script is:inline>
      // Same key as the docs, so one choice covers both. Empty or missing means follow the system.
      try {
        var t = localStorage.getItem('starlight-theme')
        var dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
      } catch (e) {}
    </script>
  </head>
  <body class="bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <Header />
    <main class={bare ? '' : 'mx-auto max-w-5xl px-4 py-12 sm:px-6'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
