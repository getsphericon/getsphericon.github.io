---
import Layout from '../layouts/Layout.astro'
import { site } from '../site'
---

<Layout title="Contact" description="Get help with Sphericon.">
  <section class="mx-auto max-w-2xl py-16">
    <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Contact</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Talk to us</h1>
    <p class="mt-6 text-slate-600 dark:text-slate-400">
      Questions, problems or feedback: write to
      <a href={`mailto:${site.supportEmail}`} class="font-medium underline">{site.supportEmail}</a>.
    </p>
    <p class="mt-4 text-slate-600 dark:text-slate-400">
      Self-hosting? The <a href="/docs/operations/runbook" class="font-medium underline">runbook</a> and
      <a href="/docs/operations/doctor" class="font-medium underline">doctor</a> cover most problems.
    </p>
  </section>
</Layout>
