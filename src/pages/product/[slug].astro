---
import Layout from '../../layouts/Layout.astro'
import { site } from '../../site'
import { products } from '../../products'

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}

const { product } = Astro.props
const others = products.filter((p) => p.slug !== product.slug)
const eyebrow = 'font-mono text-xs uppercase tracking-widest text-slate-500'
---

<Layout title={product.name} description={product.tagline}>
  <section class="pb-12 text-center">
    <p class={eyebrow}>Product</p>
    <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">{product.name}</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600 dark:text-slate-400">{product.tagline}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={site.signupUrl} class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white shadow-lg shadow-indigo-600/30 hover:bg-indigo-500">Get started</a>
      <a href={product.docs} class="border border-slate-300 px-5 py-2.5 font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900">Read the docs</a>
    </div>
  </section>

  <section class="grid gap-px border border-slate-200 bg-slate-200 sm:grid-cols-3 dark:border-slate-800 dark:bg-slate-800">
    {product.points.map((p, i) => (
      <div class="bg-white p-5 dark:bg-slate-950">
        <p class="font-mono text-xs text-slate-400">0{i + 1}</p>
        <h2 class="mt-2 font-semibold">{p.title}</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{p.text}</p>
      </div>
    ))}
  </section>

  <section class="py-16">
    <p class={eyebrow}>More of the product</p>
    <div class="mt-6 grid gap-px border border-slate-200 bg-slate-200 sm:grid-cols-2 lg:grid-cols-3 dark:border-slate-800 dark:bg-slate-800">
      {others.map((o) => (
        <a href={`/product/${o.slug}/`} class="group block bg-white p-5 hover:bg-slate-50 dark:bg-slate-950 dark:hover:bg-slate-900">
          <h3 class="font-mono text-sm font-semibold">{o.name} <span class="text-slate-400">→</span></h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{o.short}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
