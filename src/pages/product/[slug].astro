---
import Layout from '../../layouts/Layout.astro'
import { site } from '../../site'
import { products } from '../../products'
import { icons, tone, card, tile } from '../../ui'

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}

const { product } = Astro.props
const others = products.filter((p) => p.slug !== product.slug)
const eyebrow = 'font-mono text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400'
const primary = 'rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white shadow-lg shadow-indigo-600/30 hover:bg-indigo-500'
const lineTone = {
  dim: 'text-slate-500',
  accent: 'text-indigo-300',
  ok: 'text-emerald-400',
  info: 'text-sky-300',
}
---

<Layout title={product.name} description={product.lede} bare>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-slate-200 dark:border-slate-800">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-32 left-1/2 size-[28rem] -translate-x-1/2 rounded-full bg-indigo-500/10 blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-5xl px-4 pb-16 pt-14 text-center sm:px-6">
      <p class={eyebrow}>{product.name}</p>
      <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">{product.headline}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{product.lede}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.signupUrl} class={primary}>Get started</a>
        <a href={product.docs} class="rounded-lg border border-slate-300 px-5 py-2.5 font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900">How it works in the docs</a>
      </div>

      <div class="mx-auto mt-12 max-w-2xl overflow-hidden rounded-xl border border-slate-800 bg-slate-950 text-left shadow-2xl">
        <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5">
          <span class="size-2.5 rounded-full bg-rose-400"></span>
          <span class="size-2.5 rounded-full bg-amber-400"></span>
          <span class="size-2.5 rounded-full bg-emerald-400"></span>
          <span class="ml-3 font-mono text-xs text-slate-500">{product.example.title}</span>
        </div>
        <div class="overflow-x-auto p-5 font-mono text-xs leading-relaxed text-slate-200">
          {product.example.lines.map(([text, t]) => (
            <p class={`whitespace-pre ${t ? lineTone[t] : ''}`}>{text || ' '}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-2">
      {product.benefits.map((b) => (
        <div class={`${card} flex gap-4`}>
          <div class={`${tile} ${tone.indigo} shrink-0`} set:html={icons[b.icon]} />
          <div>
            <h2 class="font-semibold">{b.title}</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{b.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-slate-200 bg-slate-50 py-20 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <p class={eyebrow}>How it works</p>
      <ol class="mt-8 grid gap-6 sm:grid-cols-3">
        {product.steps.map((s, i) => (
          <li>
            <span class="flex size-8 items-center justify-center rounded-full bg-indigo-600 font-mono text-sm font-semibold text-white">{i + 1}</span>
            <h3 class="mt-4 font-semibold">{s.title}</h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-4 py-20 sm:px-6">
    <div class="mx-auto max-w-5xl rounded-2xl bg-indigo-600 px-6 py-14 text-center text-white shadow-xl">
      <h2 class="text-3xl font-bold tracking-tight">{product.closing}</h2>
      <p class="mx-auto mt-3 max-w-xl text-indigo-100">Create a workspace on Sphericon Cloud, or run it yourself.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.signupUrl} class="rounded-lg bg-white px-5 py-2.5 font-medium text-indigo-700 shadow-lg hover:bg-indigo-50">Create your workspace</a>
        <a href="/docs/self-hosting" class="rounded-lg border border-white/40 px-5 py-2.5 font-medium hover:bg-white/10">Self-host</a>
      </div>
    </div>
  </section>

  <!-- More -->
  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <p class={eyebrow}>More of the product</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {others.map((o) => (
        <a href={`/product/${o.slug}/`} class={`${card} group block`}>
          <h3 class="font-semibold">{o.name} <span class="text-slate-400 transition group-hover:translate-x-0.5">→</span></h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{o.short}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
