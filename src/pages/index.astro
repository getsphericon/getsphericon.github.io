---
import Layout from '../layouts/Layout.astro'
import { site } from '../site'
import { icons, tone, card, tile } from '../ui'
import { useCases } from '../useCases'

const model = [
  { name: 'Contact', icon: icons.user, tone: tone.indigo, text: 'One record per person, identified or still anonymous, with typed custom fields and tags.' },
  { name: 'Event', icon: icons.zap, tone: tone.amber, text: 'An immutable fact: signed_up, viewed_pricing, email.opened. Behavior you can segment on.' },
  { name: 'Segment', icon: icons.filter, tone: tone.emerald, text: 'A saved rule evaluated live. Membership is never copied, so there are no stale lists.' },
  { name: 'Send-eligibility', icon: icons.shield, tone: tone.rose, text: 'Consent is derived, not a flag. Suppressions and opt-in are checked on every send path.' },
]

const flow = [
  { n: 'Contact', c: 'border border-slate-200 bg-white text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white' },
  { n: 'Event', c: 'border border-slate-200 bg-white text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white' },
  { n: 'Segment', c: 'border border-slate-200 bg-white text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white' },
  { n: 'Send', c: 'border border-slate-200 bg-white text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white' },
]

const timeline = [
  { icon: icons.zap, title: 'A visitor looks at pricing', text: 'The tracker records the event on an anonymous visitor.', tag: 'viewed_pricing' },
  { icon: icons.user, title: 'They sign up', text: 'Identify binds the visitor to a contact, and what they did earlier is stitched onto it.', tag: 'identify' },
  { icon: icons.filter, title: 'A segment picks them up', text: 'Rules are evaluated live, so they match the moment their data says so.', tag: 'segment' },
  { icon: icons.workflow, title: 'An automation welcomes them', text: 'Started by the event, run once per contact, with consent checked on every send.', tag: 'automation' },
  { icon: icons.eye, title: 'You see what happened', text: 'Sent, opened, clicked, unsubscribed. Those are events too, so you can segment on them.', tag: 'report' },
]

const works = ['SMTP', 'Amazon SES', 'Postmark', 'Mailgun', 'ClickHouse', 'Webhooks', 'OpenAPI', 'MCP']

const access = [
  { name: 'App', icon: icons.layout, tone: tone.indigo, text: 'The workspace UI for contacts, segments and campaigns.', href: '/docs/guide/app' },
  { name: 'API', icon: icons.code, tone: tone.sky, text: 'Everything the app does, over an OpenAPI-described REST API.', href: '/docs/guide/api' },
  { name: 'Webhooks', icon: icons.webhook, tone: tone.amber, text: 'Delivery and engagement events pushed to your systems.', href: '/docs/guide/webhooks' },
  { name: 'MCP', icon: icons.bot, tone: tone.violet, text: 'Claude or any MCP client operates the workspace, drafts only by default.', href: '/docs/guide/mcp' },
]

const agentTools = [
  { name: 'contacts_*', dot: 'bg-indigo-400', text: 'Read and upsert contacts, tags and events' },
  { name: 'segments_*', dot: 'bg-indigo-400', text: 'Build segments and preview who matches' },
  { name: 'broadcasts_*', dot: 'bg-indigo-400', text: 'Draft broadcasts, send tests, read reports' },
  { name: 'automations_*', dot: 'bg-indigo-400', text: 'Author automations, dry-run their steps' },
  { name: 'email_lint', dot: 'bg-indigo-400', text: 'Check a message before it is saved' },
]

const safety = [
  { name: 'Drafts by default', icon: icons.send, text: 'Agents author broadcasts and automations as drafts. Sending needs its own scope plus mcp:send, otherwise the tools are not even listed.' },
  { name: 'Consent only narrows', icon: icons.lock, text: 'An agent can suppress an address or record an unsubscribe. Lifting a suppression is not available over the API or MCP.' },
  { name: 'Contact text is data', icon: icons.eye, text: 'Names, fields and event properties come back wrapped as untrusted data, and the model is told never to treat them as instructions.' },
]

const faq = [
  { q: 'What is Sphericon?', a: 'An open-source, multi-tenant, API-first marketing automation platform: contacts, events, segments, broadcasts and automations.' },
  { q: 'Can I self-host it?', a: 'Yes. The same product runs on your own infrastructure or on Sphericon Cloud. See the self-hosting guide.' },
  { q: 'How is consent handled?', a: 'Whether you may write to someone is derived on every send: suppressions, unsubscribes and, if you require it, confirmed opt-in.' },
  { q: 'Is it AI-first?', a: 'Yes. Every API operation is exposed as an MCP tool at /mcp, so an agent can read contacts, build segments, draft broadcasts and author automations. Sending stays behind its own scope and a human.' },
  { q: 'Which agents can connect?', a: 'Claude Code and any MCP client with a Bearer token, or claude.ai custom connectors over OAuth 2.1.' },
]

const wrap = 'mx-auto max-w-5xl px-4 sm:px-6'
const eyebrow = 'font-mono text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400'
const primary =
  'rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white shadow-lg shadow-indigo-600/30 hover:bg-indigo-500'
---

<Layout title="Sphericon" bare>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-slate-200 dark:border-slate-800">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-32 left-1/4 size-[28rem] rounded-full bg-indigo-500/10 blur-3xl"></div>
      <div class="absolute inset-0 opacity-50 [background-image:radial-gradient(circle,#94a3b8_1px,transparent_1px)] [background-size:24px_24px] [mask-image:linear-gradient(to_bottom,black,transparent_70%)]"></div>
    </div>
    <div class={`${wrap} pb-20 pt-16 text-center`}>
      <a
        href={site.githubUrl}
        class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/70 px-3 py-1 font-mono text-xs text-indigo-700 backdrop-blur hover:bg-white dark:border-indigo-500/30 dark:bg-slate-900/60 dark:text-indigo-300"
      >
        <span class="size-1.5 animate-pulse rounded-full bg-emerald-500"></span> Open source · AI-first · MCP server built in
      </a>
      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
        <span class="text-indigo-600 dark:text-indigo-400">AI-first</span>{' '}
        marketing automation you can own
      </h1>
      <ul class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-2 text-sm font-medium">
        <li class="flex items-center gap-2 rounded-full px-3.5 py-1.5 border border-slate-200 bg-white/70 text-slate-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300"><span class="text-indigo-600 dark:text-indigo-400 [&>svg]:size-4" set:html={icons.bot} />MCP-native</li>
        <li class="flex items-center gap-2 rounded-full px-3.5 py-1.5 border border-slate-200 bg-white/70 text-slate-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300"><span class="text-indigo-600 dark:text-indigo-400 [&>svg]:size-4" set:html={icons.code} />On-premise</li>
        <li class="flex items-center gap-2 rounded-full px-3.5 py-1.5 border border-slate-200 bg-white/70 text-slate-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300"><span class="text-indigo-600 dark:text-indigo-400 [&>svg]:size-4" set:html={icons.lock} />You own your data</li>
        <li class="flex items-center gap-2 rounded-full px-3.5 py-1.5 border border-slate-200 bg-white/70 text-slate-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300"><span class="text-indigo-600 dark:text-indigo-400 [&>svg]:size-4" set:html={icons.zap} />SaaS</li>
      </ul>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.signupUrl} class={primary}>Get started</a>
        <a href={site.docsUrl} class="rounded-lg border border-slate-300 bg-white/70 px-5 py-2.5 font-medium backdrop-blur hover:bg-white dark:border-slate-700 dark:bg-slate-900/60 dark:hover:bg-slate-900">
          Read the docs
        </a>
      </div>
      <div class="relative mx-auto mt-14 max-w-4xl">
        <div class="absolute -inset-4 -z-10 rounded-3xl bg-gradient-to-r from-indigo-500/10 to-indigo-500/10 blur-2xl"></div>
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
          <div class="flex items-center gap-1.5 border-b border-slate-200 px-4 py-2.5 dark:border-slate-700">
            <span class="size-2.5 rounded-full bg-rose-400"></span>
            <span class="size-2.5 rounded-full bg-amber-400"></span>
            <span class="size-2.5 rounded-full bg-emerald-400"></span>
          </div>
          <div class="overflow-x-auto">
            <img src="/images/screenshot.png" alt="The Sphericon workspace overview" class="w-full min-w-[44rem]" width="2880" height="1660" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Model -->
  <section class="py-20">
    <div class={wrap}>
      <p class={eyebrow}>The model</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Know your contacts, then write to the right ones</h2>

      <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        {flow.map((s, i) => (
          <>
            <div class={`flex-1 rounded-lg ${s.c} px-4 py-3 text-center font-mono text-sm font-semibold shadow-sm`}>{s.n}</div>
            {i < flow.length - 1 && <span class="text-center font-mono text-slate-400">→</span>}
          </>
        ))}
      </div>

      <dl class="mt-12 grid gap-x-12 gap-y-8 sm:grid-cols-2">
        {model.map((m) => (
          <div class="flex gap-4">
            <span class="mt-0.5 text-indigo-600 dark:text-indigo-400" set:html={m.icon} />
            <div>
              <dt class="font-semibold">{m.name}</dt>
              <dd class="mt-1 text-sm text-slate-600 dark:text-slate-400">{m.text}</dd>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Surfaces (bento) -->
  <section class="border-y border-slate-200 bg-slate-50 py-20 dark:border-slate-800 dark:bg-slate-900/40">
    <div class={wrap}>
      <p class={eyebrow}>What you can send</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Three surfaces, one set of rules</h2>
      <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
        Templates, sending domain checks and consent rules are shared by all of them.
      </p>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <div class={`${card} md:col-span-2`}>
          <div class={`${tile} ${tone.indigo}`} set:html={icons.send} />
          <h3 class="mt-4 font-semibold">Broadcast</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">One email to a segment, now or scheduled, with a report of sent, opened, clicked and unsubscribed.</p>
          <div class="mt-5 flex flex-wrap items-center gap-2 text-slate-400">
            {['draft', 'scheduled', 'sending', 'sent'].map((st, i, all) => (
              <>
                <span class="rounded-md border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs dark:border-slate-700 dark:bg-slate-800 text-slate-700 dark:text-slate-200">{st}</span>
                {i < all.length - 1 && <span class="font-mono text-xs">→</span>}
              </>
            ))}
          </div>
        </div>
        <div class={card}>
          <div class={`${tile} ${tone.indigo}`} set:html={icons.receipt} />
          <h3 class="mt-4 font-semibold">Transactional</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">A single email your app triggers over the API, such as a receipt.</p>
          <p class="mt-5"><span class="rounded-md border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs dark:border-slate-700 dark:bg-slate-800 text-slate-700 dark:text-slate-200">POST /api/emails</span></p>
        </div>
        <div class={`${card} md:col-span-3`}>
          <div class="flex flex-wrap items-start justify-between gap-6">
            <div class="max-w-md">
              <div class={`${tile} ${tone.indigo}`} set:html={icons.workflow} />
              <h3 class="mt-4 font-semibold">Automation</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">A sequence started by an event, run once per contact. Created as a draft, live only when you activate it.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-slate-400">
              {['signed_up', 'email', 'wait 2 days', 'email', 'apply_tag'].map((st, i, all) => (
                <>
                  <span class="rounded-md border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs dark:border-slate-700 dark:bg-slate-800 text-slate-700 dark:text-slate-200">{st}</span>
                  {i < all.length - 1 && <span class="font-mono text-xs">→</span>}
                </>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20">
    <div class={wrap}>
      <p class={eyebrow}>From event to email</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">What happens after someone shows up</h2>
      <ol class="mt-12 ml-4 space-y-10 border-l border-slate-200 pl-10 dark:border-slate-800">
        {timeline.map((t) => (
          <li class="relative">
            <span class="absolute -left-[3.75rem] top-0 flex size-9 items-center justify-center rounded-full border border-slate-200 bg-white text-indigo-600 dark:border-slate-700 dark:bg-slate-900 dark:text-indigo-400" set:html={t.icon} />
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="font-semibold">{t.title}</h3>
              <span class="rounded-md border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs dark:border-slate-700 dark:bg-slate-800 text-slate-500">{t.tag}</span>
            </div>
            <p class="mt-1 max-w-xl text-sm text-slate-600 dark:text-slate-400">{t.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-20">
    <div class={wrap}>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class={eyebrow}>Use cases</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">What teams do with it</h2>
        </div>
        <a href="/use-cases/" class="text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400">All use cases →</a>
      </div>
      <ul class="mt-10 grid gap-x-12 border-b border-slate-200 sm:grid-cols-2 dark:border-slate-800">
        {useCases.map((u) => (
          <li class="border-t border-slate-200 dark:border-slate-800">
            <a href={`/use-cases/#${u.slug}`} class="group flex items-start gap-4 py-5">
              <span class="mt-0.5 text-indigo-600 dark:text-indigo-400" set:html={u.icon} />
              <span>
                <span class="block font-semibold">{u.name} <span class="text-slate-400 transition group-hover:translate-x-0.5">→</span></span>
                <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">{u.text}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- AI-first / MCP -->
  <section class="relative overflow-hidden bg-slate-950 py-20 text-white">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -left-24 top-0 size-[26rem] rounded-full bg-indigo-600/15 blur-3xl"></div>
      <div class="absolute -right-24 bottom-0 size-[26rem] rounded-full bg-indigo-600/10 blur-3xl"></div>
    </div>
    <div class={`${wrap} relative`}>
      <p class="font-mono text-xs font-semibold uppercase tracking-widest text-indigo-300">AI-first</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Your agent can run the workspace</h2>
      <p class="mt-3 max-w-2xl text-slate-300">
        Sphericon serves a Model Context Protocol endpoint at <code class="font-mono text-sm text-indigo-300">/mcp</code>, the same
        binary and data as the API. The tools are projected from the API contract, not written by hand,
        so an agent never lags behind the product.
      </p>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="overflow-hidden rounded-xl border border-white/10 bg-slate-900/80 shadow-2xl backdrop-blur">
          <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5">
            <span class="size-2.5 rounded-full bg-rose-400"></span>
            <span class="size-2.5 rounded-full bg-amber-400"></span>
            <span class="size-2.5 rounded-full bg-emerald-400"></span>
            <span class="ml-3 font-mono text-xs text-slate-500">claude</span>
          </div>
          <div class="p-5 font-mono text-xs leading-relaxed text-slate-200">
            <p class="text-slate-500"># Connect Claude Code</p>
            <p class="mt-2 whitespace-pre-wrap break-all"><span class="text-indigo-300">claude mcp add</span> --transport http sphericon \
  https://your-sphericon/mcp \
  --header "Authorization: Bearer $SPHERICON_TOKEN"</p>
            <p class="mt-5 text-slate-500"># Then ask</p>
            <p class="mt-2 text-emerald-400">&gt; Draft a win-back broadcast for contacts who went quiet.</p>
            <p class="mt-1 text-indigo-300">segments_preview → broadcasts_create → email_lint</p>
            <p class="mt-1 text-slate-400">Draft saved. Review and send it in the app.</p>
          </div>
        </div>
        <div class="grid content-start divide-y divide-white/10 border-y border-white/10">
          {agentTools.map((t) => (
            <div class="flex items-center justify-between gap-4 py-3">
              <code class="flex items-center gap-2 font-mono text-sm font-semibold"><span class={`size-2 rounded-full ${t.dot}`}></span>{t.name}</code>
              <span class="text-right text-sm text-slate-300">{t.text}</span>
            </div>
          ))}
        </div>
      </div>
      <p class="mt-6 text-sm text-slate-300">
        Clients that sign in, such as claude.ai custom connectors, connect over OAuth 2.1. Playbooks
        for a welcome automation, a win-back broadcast and list hygiene are built in.
        <a href="/docs/guide/mcp" class="font-medium text-indigo-300 underline">Read the MCP guide →</a>
      </p>
      <div class="mt-10 grid gap-8 border-t border-white/10 pt-8 sm:grid-cols-3">
        {safety.map((s) => (
          <div>
            <span class="text-indigo-300" set:html={s.icon} />
            <h3 class="mt-3 font-semibold">{s.name}</h3>
            <p class="mt-2 text-sm text-slate-300">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Access -->
  <section class="py-20">
    <div class={wrap}>
      <p class={eyebrow}>For humans and agents</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Use it from the app, your code or an agent</h2>
      <div class="mt-10 grid divide-y divide-slate-200 border-y border-slate-200 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x dark:divide-slate-800 dark:border-slate-800">
        {access.map((a) => (
          <a href={a.href} class="group block p-5 hover:bg-slate-50 dark:hover:bg-slate-900/50">
            <span class="text-indigo-600 dark:text-indigo-400" set:html={a.icon} />
            <h3 class="mt-3 font-semibold">{a.name} <span class="text-slate-400 transition group-hover:translate-x-0.5">→</span></h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{a.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Works with -->
  <section class="pb-20">
    <div class={wrap}>
      <p class="text-center text-sm text-slate-500">
        Send through SMTP or SES, get bounce callbacks from SES, Postmark and Mailgun, export to ClickHouse, connect agents over MCP.
        <a href="/integrations/" class="font-medium text-indigo-600 hover:underline dark:text-indigo-400">All integrations →</a>
      </p>
      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {works.map((w) => (
          <li class="rounded-full border border-slate-200 bg-white px-4 py-1.5 font-mono text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">{w}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-4 sm:px-6">
    <div class="relative mx-auto max-w-5xl overflow-hidden rounded-2xl bg-indigo-600 px-6 py-16 text-center text-white shadow-xl">
      <div class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full bg-white/10 blur-2xl"></div>
      <h2 class="relative text-3xl font-bold tracking-tight">Start sending in minutes</h2>
      <p class="relative mx-auto mt-3 max-w-xl text-indigo-100">
        Create a workspace on Sphericon Cloud, or run it yourself.
      </p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.signupUrl} class="rounded-lg bg-white px-5 py-2.5 font-medium text-indigo-700 shadow-lg hover:bg-indigo-50">
          Create your workspace
        </a>
        <a href="/docs/self-hosting" class="rounded-lg border border-white/40 px-5 py-2.5 font-medium hover:bg-white/10">
          Self-host
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>FAQ</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight">Questions</h2>
      <div class="mt-8 space-y-3">
        {faq.map((f) => (
          <details class="group rounded-xl border border-slate-200 bg-white px-5 py-4 open:shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <summary class="flex cursor-pointer list-none items-center justify-between font-medium">
              {f.q}
              <span class="font-mono text-indigo-500 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
