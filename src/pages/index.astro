---
import Layout from '../layouts/Layout.astro'
import { site } from '../site'

const model = [
  { name: 'Contact', text: 'One record per person, identified or still anonymous, with typed custom fields and tags.' },
  { name: 'Event', text: 'An immutable fact: signed_up, viewed_pricing, email.opened. Behavior you can segment on.' },
  { name: 'Segment', text: 'A saved rule evaluated live. Membership is never copied, so there are no stale lists.' },
  { name: 'Send-eligibility', text: 'Consent is derived, not a flag. Suppressions and opt-in are checked on every send path.' },
]

const surfaces = [
  { name: 'Broadcast', text: 'One email to a segment, now or scheduled, with a report.' },
  { name: 'Automation', text: 'A sequence started by an event, run once per contact.' },
  { name: 'Transactional', text: 'A single email your app triggers over the API, such as a receipt.' },
]

const access = [
  { name: 'App', text: 'The workspace UI for contacts, segments and campaigns.', href: '/docs/guide/app' },
  { name: 'API', text: 'Everything the app does, over an OpenAPI-described REST API.', href: '/docs/guide/api' },
  { name: 'Webhooks', text: 'Delivery and engagement events pushed to your systems.', href: '/docs/guide/webhooks' },
  { name: 'MCP', text: 'Claude or any MCP client operates the workspace, drafts only by default.', href: '/docs/guide/mcp' },
]

const faq = [
  { q: 'What is Sphericon?', a: 'An open-source, multi-tenant, API-first marketing automation platform: contacts, events, segments, broadcasts and automations.' },
  { q: 'Can I self-host it?', a: 'Yes. The same product runs on your own infrastructure or on Sphericon Cloud. See the self-hosting guide.' },
  { q: 'How is consent handled?', a: 'Whether you may write to someone is derived on every send: suppressions, unsubscribes and, if you require it, confirmed opt-in.' },
  { q: 'Is it AI-first?', a: 'Yes. Every API operation is exposed as an MCP tool at /mcp, so an agent can read contacts, build segments, draft broadcasts and author automations. Sending stays behind its own scope and a human.' },
  { q: 'Which agents can connect?', a: 'Claude Code and any MCP client with a Bearer token, or claude.ai custom connectors over OAuth 2.1.' },
]

const agentTools = [
  { name: 'contacts_*', text: 'Read and upsert contacts, tags and events' },
  { name: 'segments_*', text: 'Build segments and preview who matches' },
  { name: 'broadcasts_*', text: 'Draft broadcasts, send tests, read reports' },
  { name: 'automations_*', text: 'Author automations, dry-run their steps' },
  { name: 'email_lint', text: 'Check a message before it is saved' },
]

const safety = [
  { name: 'Drafts by default', text: 'Agents author broadcasts and automations as drafts. Sending needs its own scope plus mcp:send, otherwise the tools are not even listed.' },
  { name: 'Consent only narrows', text: 'An agent can suppress an address or record an unsubscribe. Lifting a suppression is not available over the API or MCP.' },
  { name: 'Contact text is data', text: 'Names, fields and event properties come back wrapped as untrusted data, and the model is told never to treat them as instructions.' },
]

const card = 'border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950'
const eyebrow = 'font-mono text-xs uppercase tracking-widest text-slate-500'
---

<Layout title="Sphericon">
  <!-- Hero -->
  <section class="relative -mx-4 border-b border-slate-200 px-4 pb-16 pt-12 text-center sm:-mx-6 sm:px-6 dark:border-slate-800">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60 [background-image:radial-gradient(circle,#94a3b8_1px,transparent_1px)] [background-size:24px_24px] [mask-image:linear-gradient(to_bottom,black,transparent)]"
    >
    </div>
    <a
      href={site.githubUrl}
      class="inline-flex items-center gap-2 border border-slate-200 px-3 py-1 font-mono text-xs text-slate-600 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-900"
    >
      <span class="size-1.5 rounded-full bg-emerald-500"></span> Open source · AI-first · MCP server built in
    </a>
    <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
      AI-first marketing automation you can own
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
      Operate it from the app, the API or your AI agent. Every API operation is an MCP tool, so
      Claude or any MCP client can build segments, draft broadcasts and author automations.
      Self-host it or run it in the cloud.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={site.signupUrl} class="bg-slate-900 px-5 py-2.5 font-medium text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
        Get started
      </a>
      <a href={site.docsUrl} class="border border-slate-300 px-5 py-2.5 font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900">
        Read the docs
      </a>
    </div>
    <div class="mx-auto mt-12 max-w-4xl border border-slate-200 bg-white p-1.5 shadow-xl dark:border-slate-800 dark:bg-slate-900">
      <img src="/images/screenshot.png" alt="The Sphericon workspace overview" class="w-full" width="1600" height="900" />
    </div>
  </section>

  <!-- AI-first / MCP -->
  <section class="py-20">
    <p class={eyebrow}>AI-first</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Your agent can run the workspace</h2>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
      Sphericon serves a Model Context Protocol endpoint at <code class="font-mono text-sm">/mcp</code>, the same
      binary and data as the API. The tools are projected from the API contract, not written by hand,
      so an agent never lags behind the product.
    </p>
    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="border border-slate-200 bg-slate-950 p-5 font-mono text-xs leading-relaxed text-slate-200 dark:border-slate-800">
        <p class="text-slate-500"># Connect Claude Code</p>
        <p class="mt-2 whitespace-pre-wrap break-all">claude mcp add --transport http sphericon \
  https://your-sphericon/mcp \
  --header "Authorization: Bearer $SPHERICON_TOKEN"</p>
        <p class="mt-5 text-slate-500"># Then ask</p>
        <p class="mt-2 text-emerald-400">&gt; Draft a win-back broadcast for contacts who went quiet.</p>
        <p class="mt-1 text-slate-400">segments_preview → broadcasts_create → email_lint</p>
        <p class="mt-1 text-slate-400">Draft saved. Review and send it in the app.</p>
      </div>
      <div class="grid gap-px border border-slate-200 bg-slate-200 dark:border-slate-800 dark:bg-slate-800">
        {agentTools.map((t) => (
          <div class={`${card} flex items-baseline justify-between gap-4`}>
            <code class="font-mono text-sm font-semibold">{t.name}</code>
            <span class="text-right text-sm text-slate-600 dark:text-slate-400">{t.text}</span>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-6 text-sm text-slate-600 dark:text-slate-400">
      Clients that sign in, such as claude.ai custom connectors, connect over OAuth 2.1. Playbooks
      for a welcome automation, a win-back broadcast and list hygiene are built in.
      <a href="/docs/guide/mcp" class="font-medium underline">Read the MCP guide →</a>
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {safety.map((s) => (
        <div class={card}>
          <h3 class="font-mono text-sm font-semibold">{s.name}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Model -->
  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <p class={eyebrow}>The model</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Know your contacts, then write to the right ones</h2>
    <div class="mt-10 grid gap-px border border-slate-200 bg-slate-200 sm:grid-cols-2 dark:border-slate-800 dark:bg-slate-800">
      {model.map((m, i) => (
        <div class={card}>
          <p class="font-mono text-xs text-slate-400">0{i + 1}</p>
          <h3 class="mt-2 text-lg font-semibold">{m.name}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{m.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Surfaces -->
  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <p class={eyebrow}>What you can send</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Three surfaces, one set of rules</h2>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
      Templates, sending domain checks and consent rules are shared by all of them.
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {surfaces.map((s) => (
        <div class={card}>
          <h3 class="font-mono text-sm font-semibold">{s.name}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Access -->
  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <p class={eyebrow}>For humans and agents</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Use it from the app, your code or an agent</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {access.map((a) => (
        <a href={a.href} class={`${card} group block hover:bg-slate-50 dark:hover:bg-slate-900`}>
          <h3 class="font-mono text-sm font-semibold">{a.name} <span class="text-slate-400 transition group-hover:translate-x-0.5">→</span></h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{a.text}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-y border-slate-200 bg-slate-50 px-6 py-16 text-center dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-3xl font-bold tracking-tight">Start sending in minutes</h2>
    <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">
      Create a workspace on Sphericon Cloud, or run it yourself.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={site.signupUrl} class="bg-slate-900 px-5 py-2.5 font-medium text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
        Create your workspace
      </a>
      <a href="/docs/self-hosting" class="border border-slate-300 px-5 py-2.5 font-medium hover:bg-white dark:border-slate-700 dark:hover:bg-slate-800">
        Self-host
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20">
    <p class={eyebrow}>FAQ</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight">Questions</h2>
    <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {faq.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between font-medium">
            {f.q}
            <span class="font-mono text-slate-400 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
