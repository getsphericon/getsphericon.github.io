---
import { site } from '../site'
import { products } from '../products'
import Logo from './Logo.astro'
---

<header class="relative border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-4 sm:gap-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 text-base font-semibold sm:text-lg"><Logo />Sphericon</a>
    <div class="flex items-center gap-1.5 text-sm sm:gap-4 md:gap-6">
      <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
        <div class="group relative">
          <button type="button" class="flex items-center gap-1 hover:underline">
            Product <span class="text-xs text-slate-400">▾</span>
          </button>
          <div
            class="invisible absolute left-0 top-full z-10 w-72 border border-slate-200 bg-white pt-2 opacity-0 shadow-xl transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 dark:border-slate-800 dark:bg-slate-950"
          >
            <ul class="p-1">
              {products.map((p) => (
                <li>
                  <a href={`/product/${p.slug}/`} class="block px-3 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">
                    <span class="block font-medium">{p.name}</span>
                    <span class="block text-xs text-slate-500">{p.short}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <a href="/integrations/" class="hover:underline">Integrations</a>
        <a href="/pricing/" class="hover:underline">Pricing</a>
        <a href="/blog/" class="hover:underline">Blog</a>
        <a href={site.docsUrl} class="hover:underline">Docs</a>
      </nav>
      <button
        type="button"
        id="theme-toggle"
        class="flex size-8 shrink-0 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white"
      >
        <svg data-theme-icon="auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <svg data-theme-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden size-4"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg data-theme-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden size-4"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a
        href={site.signupUrl}
        class="whitespace-nowrap rounded-lg bg-indigo-600 px-2.5 py-1.5 font-medium sm:px-3 text-white hover:bg-indigo-500"
      >
        Get started
      </a>
      <button
        type="button"
        id="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Menu"
        class="flex size-8 shrink-0 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-900 md:hidden dark:hover:bg-slate-800 dark:hover:text-white"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="size-5"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-slate-200 px-4 py-3 text-sm dark:border-slate-800 sm:px-6 md:hidden">
    <p class="px-3 pb-1 pt-2 font-mono text-xs uppercase tracking-widest text-slate-500">Product</p>
    <ul>
      {products.map((p) => (
        <li>
          <a href={`/product/${p.slug}/`} class="block rounded-lg px-3 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">
            <span class="block font-medium">{p.name}</span>
            <span class="block text-xs text-slate-500">{p.short}</span>
          </a>
        </li>
      ))}
    </ul>
    <ul class="mt-2 border-t border-slate-200 pt-2 dark:border-slate-800">
      <li><a href="/integrations/" class="block rounded-lg px-3 py-2 font-medium hover:bg-slate-50 dark:hover:bg-slate-900">Integrations</a></li>
      <li><a href="/pricing/" class="block rounded-lg px-3 py-2 font-medium hover:bg-slate-50 dark:hover:bg-slate-900">Pricing</a></li>
      <li><a href="/blog/" class="block rounded-lg px-3 py-2 font-medium hover:bg-slate-50 dark:hover:bg-slate-900">Blog</a></li>
      <li><a href={site.docsUrl} class="block rounded-lg px-3 py-2 font-medium hover:bg-slate-50 dark:hover:bg-slate-900">Docs</a></li>
    </ul>
  </nav>
</header>

<script>
  // Auto (follow the system) -> light -> dark. Auto is stored as '', like the docs do.
  const key = 'starlight-theme'
  const order = ['', 'light', 'dark']
  const labels: Record<string, string> = { '': 'auto', light: 'light', dark: 'dark' }
  const button = document.getElementById('theme-toggle')

  const stored = () => {
    try {
      return localStorage.getItem(key) ?? ''
    } catch {
      return ''
    }
  }

  const apply = () => {
    const pref = stored()
    const dark = pref === 'dark' || (pref !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
    document.documentElement.classList.toggle('dark', dark)
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
    document.querySelectorAll<SVGElement>('[data-theme-icon]').forEach((icon) => {
      icon.classList.toggle('hidden', icon.dataset.themeIcon !== (labels[pref] ?? 'auto'))
    })
    button?.setAttribute('aria-label', `Theme: ${labels[pref] ?? 'auto'}. Click to change.`)
    button?.setAttribute('title', `Theme: ${labels[pref] ?? 'auto'}`)
  }

  const menuButton = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  menuButton?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false
    menuButton.setAttribute('aria-expanded', String(open))
  })

  button?.addEventListener('click', () => {
    const next = order[(order.indexOf(stored()) + 1) % order.length]
    try {
      localStorage.setItem(key, next)
    } catch {}
    apply()
  })
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply)
  apply()
</script>
