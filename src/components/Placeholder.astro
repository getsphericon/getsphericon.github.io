---
import Layout from '../layouts/Layout.astro'
import { site } from '../site'

interface Props {
  title: string
}

const { title } = Astro.props
---

<Layout title={title} noindex>
  <section class="mx-auto max-w-2xl py-16">
    <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Sphericon</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">{title}</h1>
    <p class="mt-6 text-slate-600 dark:text-slate-400">
      This page is coming soon. Questions in the meantime:
      <a href={`mailto:${site.supportEmail}`} class="font-medium underline">{site.supportEmail}</a>.
    </p>
  </section>
</Layout>
